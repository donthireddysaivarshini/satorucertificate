# Copy to .env and fill in. Never commit .env.

# --- Site & Ports ---
# Change WEB_PORT if port 8000 is occupied by other docker containers on this PC (e.g. 8080, 8088, 9000)
WEB_PORT=8080
DOMAIN=localhost
SITE_URL=http://localhost:8080
ORG_NAME=Satoru Foundation
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
TIME_ZONE=Asia/Kolkata

# Optional: Ports for Caddy reverse proxy (if port 80/443 are occupied, change them or omit Caddy)
HTTP_PORT=80
HTTPS_PORT=443

# --- Database (Docker creates it with these, or use DATABASE_URL for Neon / cloud Postgres) ---
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_DB=certdesk
POSTGRES_USER=certdesk
POSTGRES_PASSWORD=change-me-too

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@yourdomain.com
# Gmail / Google Workspace: use an App Password
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=you@yourdomain.com
# Seconds between certificate emails (raise it for big batches on Gmail)
EMAIL_SEND_DELAY=2
